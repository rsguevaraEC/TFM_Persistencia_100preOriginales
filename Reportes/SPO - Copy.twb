              <calculation class='tableau' formula='([estimacion_repuestos])/ 1000000' />
            </column>
            <column caption='Mercado total estimado de repuestos' datatype='real' name='[Calculation_0614688919220234]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF UPPER(TRIM([marca])) = &quot;CHEVROLET&quot; THEN&#13;&#10;    FLOAT([Calculation_0614688916217865]) &#13;&#10;END' />
            </column>
            <column caption='Estimacion Repuestos' datatype='real' name='[estimacion_repuestos]' role='measure' type='quantitative' />
            <column caption='Fecha' datatype='date' name='[fecha]' role='dimension' type='ordinal' />
            <column caption='Marca' datatype='string' name='[marca]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0614688919220234]' derivation='Sum' name='[sum:Calculation_0614688919220234:qk]' pivot='key' type='quantitative' />
            <column-instance column='[fecha]' derivation='Year' name='[yr:fecha:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='title' class='0' field='[federated.0ihgaoy0g5jhm416f37hw1rp3cgl].[sum:Calculation_0614688919220234:qk]' scope='rows' value='Mercado estimado de repuestos (USD MM)' />
