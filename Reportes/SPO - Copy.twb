    <worksheet name='VENTAS VEH (GRAFICO)'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Tableau Book' fontsize='12'>Evolución histórica de ventas de vehículos por marca 2007-2021</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#000000' fontname='Segoe UI' fontsize='10'>Unidades por año según marcas y período seleccionados</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='market_review_simplificado (spo.market_review_simplificado) (postgres)' name='federated.19xv00s02eqy6o1d8j12q1378j0p' />
          </datasources>
          <datasource-dependencies datasource='federated.19xv00s02eqy6o1d8j12q1378j0p'>
            <column caption='Año' datatype='string' name='[Calculation_0748554061574146]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([anio])' />
            </column>
            <column caption='Total Marca' datatype='integer' name='[Calculation_0748554072453123]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [marca] : SUM([unidades]) }' />
            </column>
            <column caption='Marca Agrupada' datatype='string' name='[Calculation_0748554072588292]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_0748554072453123] &lt; 1500 THEN&#13;&#10;    &quot;OTRAS&quot;&#13;&#10;ELSE&#13;&#10;    [marca]&#13;&#10;END' />
            </column>
            <column caption='Tooltip Marca' datatype='string' name='[Calculation_0748554075299845]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ATTR([Calculation_0748554072588292]) = &quot;OTRAS&quot; THEN&#13;&#10;    &quot;OTRAS agrupa las marcas cuyo volumen histórico total es inferior a 1.000 unidades, correponden principalmente a marcas Chinas que empezaban a introducirse y desaparecieron, o modelos de alta gama de importaciones puntuales&quot;&#13;&#10;ELSE&#13;&#10;    &quot;&quot;&#13;&#10;END' />
            </column>
            <column caption='Anio' datatype='integer' name='[anio]' role='measure' type='quantitative' />
            <column caption='Marca' datatype='string' name='[marca]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0748554061574146]' derivation='None' name='[none:Calculation_0748554061574146:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0748554072588292]' derivation='None' name='[none:Calculation_0748554072588292:nk]' pivot='key' type='nominal' />
            <column-instance column='[unidades]' derivation='Sum' name='[sum:unidades:qk]' pivot='key' type='quantitative' />
            <column caption='Unidades' datatype='integer' name='[unidades]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0748554075299845]' derivation='User' name='[usr:Calculation_0748554075299845:nk]' pivot='key' type='nominal' />
