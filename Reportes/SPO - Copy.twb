              <calculation class='tableau' formula='STR([anio])' />
            </column>
            <column caption='Total Marca' datatype='integer' name='[Calculation_0748554072453123]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [marca] : SUM([unidades]) }' />
