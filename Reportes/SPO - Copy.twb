    <worksheet name='MERCADO ESTIMADO REPUESTOS'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Mercado estimado de repuestos originales y alternos (2026-2030)</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run>El mercado estimado está calculado en base a las declaraciones de las partidas de importación de repuestos, donde GME(General Motors del Ecuador representa el 7% de las importaciones totales</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='estimacion_repuestos (spo.estimacion_repuestos) (postgres)' name='federated.0ihgaoy0g5jhm416f37hw1rp3cgl' />
