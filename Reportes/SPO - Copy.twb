          <datasource-dependencies datasource='federated.1wcrhg215z46mj1d9ea3g09yxgyb'>
            <column caption='SOM%' datatype='real' default-format='p0.0%' name='[Calculation_1420905318842369]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ZN(SUM([ventas])) &lt;&gt; 0 THEN&#13;&#10;    SUM([ventas]) / WINDOW_SUM(SUM([ventas]))&#13;&#10;ELSE&#13;&#10;    0&#13;&#10;END'>
