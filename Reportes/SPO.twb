              <groupfilter function='member' level='[none:Calculation_0748554061574146:nk]' member='&quot;2012&quot;' />
              <groupfilter function='member' level='[none:Calculation_0748554061574146:nk]' member='&quot;2013&quot;' />
              <groupfilter function='member' level='[none:Calculation_0748554061574146:nk]' member='&quot;2014&quot;' />
