              <groupfilter function='member' level='[none:Calculation_0748554061574146:nk]' member='&quot;2021&quot;' />
            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.19xv00s02eqy6o1d8j12q1378j0p].[none:Calculation_0748554072588292:nk]'>
