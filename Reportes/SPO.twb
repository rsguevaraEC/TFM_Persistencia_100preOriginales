              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0hdi9vz03fdxxg1ghueh41csx5sd].[usr:Calculation_0614688849633287:qk:2]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0hdi9vz03fdxxg1ghueh41csx5sd].[sum:Calculation_0614688845611014:qk]&quot;' />
